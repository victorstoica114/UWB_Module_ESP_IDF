build/
build-*/
build_*/
# Firmware release archives are intentionally versioned, including images
# stored below directories whose names match the generic build rules above.
!firmware_images/
!firmware_images/**/
!firmware_images/**
managed_components/
# sdkconfig is intentionally versioned so every worktree and CI build uses
# the same ESP32-S3 target and hardware/runtime options.
sdkconfig.old
dependencies.lock
tools/ota_targets.local.txt
secrets.h
pointperfect_ntrip.txt
*.rtcm
UWB_Module/
reference/external/
.agents/
.worktrees/
.vscode/settings.json
**/.pio/
**/.secrets/
__pycache__/
*.pyc
logs/
/.tmp/

# Build tooling keeps ccache inside the repository so sandboxed and CI builds
# never depend on a user-profile cache directory.
.cache/
.ccache-store/
.ccache-tmp/

# Raw field captures are large and locally reproducible. Keep curated
# READMEs, summaries, tables, and final reports visible for versioning.
reports/**/data/
reports/**/*.jsonl
reports/**/*.jsonl.xz
reports/**/*.metadata.json
reports/**/*.sse
# RAW data inside curated report bundles is intentionally versioned (large
# capture formats remain routed through Git LFS by .gitattributes).
!reports/bundles/
!reports/bundles/**/
!reports/bundles/**/raw/
!reports/bundles/**/raw/**
reports/**/*.aux
reports/**/*.log
reports/**/*.out
reports/**/*.toc
reports/**/*.fdb_latexmk
reports/**/*.fls
reports/**/report.pdf
reports/uwb_adaptive_ekf_field_20260812/
reports/uwb_final_dynamic_20260812/
reports/uwb_final_report_input_20260812/
reports/uwb_final_static_20260812/
reports/uwb_kalman_validation_20260812/
reports/uwb_protocol_comparison_20260812/
*.bak
*.kicad_prl
fp-info-cache
