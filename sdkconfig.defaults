# ESP32-S3-WROOM-1-N16R8: 16 MB Quad SPI flash + 8 MB Octal SPI PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Keep OTA updates recoverable: a freshly flashed OTA image must prove that it
# can boot and bring up Wi-Fi/OTA before it is marked valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Resource monitor: use the ESP timer as the FreeRTOS runtime-stats clock so
# per-core load can be derived from IDLE0/IDLE1 runtime without extra timers.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Start with OTA-capable layout and a SPIFFS data partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
