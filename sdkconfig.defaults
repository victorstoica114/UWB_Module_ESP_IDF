# ESP32-S3-WROOM-1-N16R8: 16 MB Quad SPI flash + 8 MB Octal SPI PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# FlexTDOA has a 250 us receive-to-delayed-TX processing budget. Run the
# ESP32-S3 at its supported maximum frequency so the radio path is not tested
# at the lower 160 MHz default used by a generic ESP-IDF project.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Keep OTA updates recoverable: a freshly flashed OTA image must prove that it
# can boot and bring up Wi-Fi/OTA before it is marked valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A stuck task must reboot into the boot guard path instead of leaving the
# module alive but unreachable.
CONFIG_ESP_TASK_WDT_PANIC=y

# Resource monitor: use the ESP timer as the FreeRTOS runtime-stats clock so
# per-core load can be derived from IDLE0/IDLE1 runtime without extra timers.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Match the validated ESP-IDF 6.0.2 runtime configuration. Picolibc is part of
# the deployed ABI; silently switching to Newlib produced boot-time panics.
CONFIG_COMPILER_ORPHAN_SECTIONS_ERROR=y
CONFIG_LIBC_PICOLIBC=y
CONFIG_LIBC_PICOLIBC_NEWLIB_COMPATIBILITY=y
# CONFIG_PM_SLEEP_FUNC_IN_IRAM is not set
# CONFIG_PM_SLP_IRAM_OPT is not set
# CONFIG_FREERTOS_IN_IRAM is not set

# Start with OTA-capable layout and a SPIFFS data partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
