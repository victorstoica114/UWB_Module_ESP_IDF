{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF OTA Upload",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\ota_upload.ps1",
        "-HostIp",
        "${input:otaHostIp}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF OTA Upload All",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\ota_upload.ps1",
        "-TargetList",
        "${input:otaTargetList}",
        "-Parallel",
        "${input:otaParallel}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Wireless Logs",
      "type": "shell",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}\\tools\\wireless_log_listener.py",
        "--port",
        "${input:wirelessLogPort}",
        "--force-color"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Serial Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\serial_log.ps1",
        "-Port",
        "${input:serialPort}",
        "-Seconds",
        "${input:serialSeconds}",
        "-Reset"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "otaHostIp",
      "type": "promptString",
      "description": "ESP32 IP address for OTA upload",
      "default": "192.168.140.143"
    },
    {
      "id": "otaTargetList",
      "type": "promptString",
      "description": "OTA target list file",
      "default": "tools\\ota_targets.local.txt"
    },
    {
      "id": "otaParallel",
      "type": "promptString",
      "description": "OTA parallel uploads",
      "default": "5"
    },
    {
      "id": "wirelessLogPort",
      "type": "promptString",
      "description": "Wireless log TCP listener port",
      "default": "6055"
    },
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Serial port",
      "default": "COM55"
    },
    {
      "id": "serialSeconds",
      "type": "promptString",
      "description": "Serial capture seconds, 0 keeps reading",
      "default": "30"
    }
  ]
}
