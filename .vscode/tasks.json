{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF OTA Upload",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/ota_upload.py",
        "--host-ip",
        "${input:otaHostIp}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF OTA Upload All",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/ota_upload.py",
        "--target-list",
        "tools/ota_targets.local.txt",
        "--parallel",
        "5"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Wireless Logs",
      "type": "shell",
      "command": "python3",
      "args": [
        "-u",
        "${workspaceFolder}/tools/wireless_log_listener.py",
        "--port",
        "${input:wirelessLogPort}",
        "--force-color"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Serial Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\serial_log.ps1",
        "-Port",
        "${input:serialPort}",
        "-Seconds",
        "${input:serialSeconds}",
        "-Reset"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "otaHostIp",
      "type": "promptString",
      "description": "ESP32 IP address for OTA upload",
      "default": "192.168.139.72"
    },
    {
      "id": "wirelessLogPort",
      "type": "promptString",
      "description": "Wireless log TCP listener port",
      "default": "6055"
    },
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Serial port",
      "default": "COM55"
    },
    {
      "id": "serialSeconds",
      "type": "promptString",
      "description": "Serial capture seconds, 0 keeps reading",
      "default": "30"
    }
  ]
}
